{% import "_includes/forms" as forms %}

{% set readOnly = true %}
{% if adminEdits and currentUser.admin %}
        {% set readOnly = false %}
{% endif %}

{{ forms.textField({
        id: name,
        name: name,
        value: value,
        readonly: readOnly,
})
}}

{% set isHidden = hidden %}
{% if isHidden and visibleToAdmins and currentUser.admin %}
        {% set isHidden = false %}
{% endif %}

{% if readOnly %}
        <style>
                #fields-{{ name }}-field{
                        margin-bottom: 0;
                        {{ isHidden ? 'display: none;' }}
                }
                [name="{{ name }}"]{
                        cursor: copy;
                        opacity: 0.6;
                        transition: all 150ms ease-in-out;
                }
                [name="{{ name }}"]:hover{
                        opacity: 0.87;
                }
                [name="{{ name }}"]:focus{
                        opacity: 1;
                }
                [name="{{ name }}"]:active{
                        transition: all 75ms ease-in-out;
                        filter: brightness(0.95);
                }
                @keyframes readonlyNotification{
                        from{
                                opacity: 1;
                        }
                        to{
                                opacity: 0;
                        }
                }
        </style>
        <script>
                var {{ name }} = document.body.querySelector('[name="{{ name }}"]');
                if ({{ name }}){
                        {{ name }}.addEventListener('click', function(){
                                if ('clipboard' in navigator) {
                                        navigator.clipboard.writeText({{ name }}.value);
                                } else {
                                        {{ name }}.focus();
                                        {{ name }}.select();
                                        document.execCommand('copy');
                                        {{ name }}.setSelectionRange(0,0);
                                }
                                var notificationContainer = document.body.querySelector('#notifications');
                                setTimeout(()=>{
                                        notificationEl = document.createElement('div');
                                        notificationEl.innerHTML = `
                                        <div class="notification-inner">
                                                <div class="notification-body">
                                                        <div class="cp-icon notification-icon" aria-label="Success" role="img">
                                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" focusable="false" aria-hidden="true"><!--! Font Awesome Pro 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2024 Fonticons, Inc. --><path d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"></path></svg>
                                                        </div>
                                                        <div class="notification-main">
                                                                <div class="notification-message">Copied to clipboard.</div>
                                                        </div>
                                                </div>
                                        </div>
                                        `;
                                        notificationContainer.append(notificationEl);
                                        notificationEl.className = 'notification';
                                        notificationEl.dataset.type = "success";
                                        notificationEl.style.opacity = '1';
                                        notificationEl.style.display = 'block';
                                        notificationEl.style.marginBottom = "0px";
                                        notificationEl.style.animation = 'readonlyNotification 300ms 2000ms ease-out forwards';
                                        setTimeout(()=>{
                                                notificationEl?.remove();
                                        }, 2000);
                                }, 150);
                                {{ name }}?.blur();
                        });
                }
        </script>
{% endif %}
